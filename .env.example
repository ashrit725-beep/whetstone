# Session signing secret. Generate one with: openssl rand -base64 48
# Required in production. Outside production an insecure development value is
# used when this is unset, so never run production without it.
AUTH_SECRET=

# Set this to 1 behind a proxy that appends the address it saw to
# x-forwarded-for (nginx: $proxy_add_x_forwarded_for). Rate limits then key on
# that right-most entry. Unset, the left-most entry is used, which `next start`
# fills from the socket for an ordinary browser. Every auth limit also has a
# cap that ignores the address, so a forged header does not get around it.
TRUST_PROXY_HEADERS=

# Password for the one seeded account that can sign in, applied when the
# database is built (npm run db:rebuild). Outside production a local default is
# used. Every other seeded or generated member has no password at all.
SEED_PASSWORD=

# The public origin of this deployment, e.g. https://whetstone.example. Feeds,
# sitemaps and OG images use it, and emailed links are built from it rather
# than from whatever Host header a request carried. Required for mail in
# production.
SITE_URL=

# Outbound mail, for password reset links. Set MAIL_FROM and one provider key.
# Without a key (or the outbox below), production cannot send reset links: the
# server logs event "mail.unconfigured" at boot and /forgot-password says so
# instead of promising an email. Outside production each message is written to
# the server's output instead. Production also needs SITE_URL above.
#
# MAIL_FROM must be on a domain the provider has verified, for example
#   MAIL_FROM="Whetstone <no-reply@whetstone.example>"
MAIL_FROM=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# Set MAIL_TRANSPORT=outbox to write each message as an .eml file into
# MAIL_OUTBOX_DIR (default ./data/outbox) instead of emailing it: for a
# self-hosted instance with no mail provider, and for end-to-end tests
# (scripts/flows.mjs follows the reset link out of the file). Any mail client
# opens the files. It is never chosen on its own, and a production server that
# uses it logs event "mail.outbox" at boot, as a warning when a provider key is
# also set, because that key is then not used. The files hold live reset links,
# so keep the directory private. Leave MAIL_TRANSPORT empty to use the provider.
MAIL_TRANSPORT=
MAIL_OUTBOX_DIR=

# Where the SQLite file lives, resolved against the working directory.
DATABASE_PATH=./data/whetstone.db

# Model providers, all optional.
#
# They are tried in this order and the first one that answers wins, so a key
# that is absent or dead costs one refused request rather than a broken feature.
# With all three unset every AI feature runs its deterministic path instead, and
# the interface says which path produced the result rather than hiding it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
