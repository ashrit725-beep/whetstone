{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build && DATABASE_PATH=./data/whetstone.db npm run db:bake"
  },
  "deploy": {
    "startCommand": "node scripts/deploy-boot.mjs && npm run start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
